# Database
# Deployment/security defaults (use production values from docs/security-hardening.md)
ENVIRONMENT=development
ALLOWED_HOSTS=*
# Rate limits and SSO state use bounded memory in the single API worker.
RATE_LIMIT_PER_SECOND=30
AUTH_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=6291456
# Required for initial production ROOT creation; never logged in production.
# BOOTSTRAP_ROOT_PASSWORD=

# Database
MYSQL_DEV_USER=dev_project
MYSQL_DEV_PASSWORD=dev_password_please_change
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=genesis

# JWT / OAuth Core
OAUTH_ISSUER=http://localhost:8000
OAUTH_ALGORITHM=RS256
OAUTH_DEFAULT_AUDIENCE=genesis-api
OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# HS256 secret, only used outside production when no RSA key pair is set.
# No default: generate one (>= 32 chars), e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_SECRET_KEY=

# RS256 Keys (file-based for dev)
OAUTH_PRIVATE_KEY_PATH=./secrets/dev-private.pem
OAUTH_PUBLIC_KEY_PATH=./secrets/dev-public.pem
OAUTH_JWT_KID=genesis-dev-1

# JWKS
JWKS_CACHE_TTL_SECONDS=300

# CORS (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Session Management
MAX_CONCURRENT_SESSIONS=5

# SSO Providers (Phase 5 - leave blank until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# Storage (local or s3)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=

# Logging
LOG_LEVEL=INFO

# Password hashing (Argon2id via pwdlib; existing bcrypt hashes upgrade on login)
# PASSWORD_HASH_SCHEME=argon2id          # or bcrypt for a staged rollout
# PASSWORD_ARGON2_MEMORY_KIB=19456
# PASSWORD_ARGON2_TIME_COST=2
# PASSWORD_ARGON2_PARALLELISM=1
# PASSWORD_HASH_CONCURRENCY=4

# Per-account login throttling
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_LOCKOUT_MAX_SECONDS=900
# REAUTH_MAX_AGE_SECONDS=600

# Web app base URL (SSO hand-off, email links, OAuth consent page)
# FRONTEND_URL=http://localhost:5173

# Optional email verification. Genesis works without any mail service when false.
EMAIL_VERIFY=false
# EMAIL_BACKEND=smtp                    # console = log only (development; refused in production)
# EMAIL_FROM=genesis@example.com
# EMAIL_VERIFY_TOKEN_TTL_HOURS=24
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls                # starttls | tls | none (none refused in production)
